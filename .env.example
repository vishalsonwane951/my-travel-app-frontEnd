# ══════════════════════════════════════════════════════════════════════════
# Desivdesi Frontend — environment variable template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Vite only exposes variables prefixed with VITE_ to client code.
# ══════════════════════════════════════════════════════════════════════════

# ── Pre-existing ──────────────────────────────────────────────────────────
# VITE_RAPIDAPI_KEY is no longer used. Hotel search (Services/stayService.js)
# and IRCTC live-station lookups (Services/IRCTC/IRCTC.listModel.js) now go
# through the backend (Backend/Routes/HotelSearchRoutes.js and
# Backend/Routes/IRCTC/liveStationRoutes.js), which holds RAPIDAPI_KEY
# server-side instead. Set RAPIDAPI_KEY in Backend/.env, not here.
VITE_API_URL=                      # currently unused by code — Services/api.js and Services/adminApi.js hardcode
                                    # http://localhost:5000/api; update those files directly (or refactor to read
                                    # this var) before deploying to a non-localhost backend
VITE_EC2_URL=                      # currently unused by code — same note as above

# No new frontend-only secrets were introduced in Parts B/C: the Admin Panel,
# Razorpay Checkout, and all Part C features call the same backend base URL
# as the rest of the site and don't need their own keys client-side.
